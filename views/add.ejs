<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Add Medicine Alarm</title>
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="p-4 bg-white rounded shadow-sm">
                    <h2 class="mb-4 text-success">Schedule New Medicine</h2>
                    
                    <form action="/add" method="POST">
                        <div class="mb-3">
                            <label for="medicineName" class="form-label">Medicine Name</label>
                            <input type="text" class="form-control" id="medicineName" name="medicineName" placeholder="e.g. Aspirin, Cough Syrup" required>
                        </div>
                        
                        <div class="mb-4">
                            <label for="time" class="form-label">Alarm Time</label>
                            <input type="time" class="form-control" id="time" name="time" required>
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="/" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Save Alarm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
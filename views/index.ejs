<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Medicine Alarm App - Home</title>
</head>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <div class="p-4 bg-white rounded shadow-sm">
            <h1 class="mb-3 text-primary">Your Medication Schedule</h1>
            <p class="text-muted">Keep track of scheduled dosage times below. Active alarms will trigger a popup alert at their scheduled time.</p>
            
            <hr>

            <% if (alarms.length === 0) { %>
                <div class="alert alert-info text-center mt-4">
                    No alarms scheduled! Click "Add Alarm" above to setup your first reminder.
                </div>
            <% } else { %>
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Medicine Name</th>
                                <th>Reminder Time</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% alarms.forEach(alarm => { %>
                                <tr class="alarm-row" data-time="<%= alarm.time %>" data-name="<%= alarm.medicineName %>">
                                    <td><strong><%= alarm.medicineName %></strong></td>
                                    <td><span class="badge bg-secondary fs-6"><%= alarm.time %></span></td>
                                    <td><span class="badge bg-success"><%= alarm.status %></span></td>
                                    <td class="text-center">
                                        <form action="/delete/<%= alarm.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this reminder?');">
                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function checkAlarms() {
            const now = new Date();
            // Format current local hours and minutes as HH:MM
            const currentHours = String(now.getHours()).padStart(2, '0');
            const currentMinutes = String(now.getMinutes()).padStart(2, '0');
            const currentTimeStr = `${currentHours}:${currentMinutes}`;

            // Check if current system time matches any scheduled times on the page
            const alarmRows = document.querySelectorAll('.alarm-row');
            alarmRows.forEach(row => {
                const alarmTime = row.getAttribute('data-time');
                const medicineName = row.getAttribute('data-name');

                // If time matches exactly and hasn't been fired this minute
                if (currentTimeStr === alarmTime && !row.classList.contains('fired')) {
                    row.classList.add('fired'); // Prevent multiple alerts within the same minute
                    alert(`⏰ TIME TO TAKE YOUR MEDICINE:\nRemember to take your ${medicineName}!`);
                }
                
                // Clear the fired state once the minute passes
                if (currentTimeStr !== alarmTime && row.classList.contains('fired')) {
                    row.classList.remove('fired');
                }
            });
        }

        // Check the clock every 1 second
        setInterval(checkAlarms, 1000);
    </script>
</body>
</html>